<templates xml:space="preserve">
    <t t-name="odoo_qrcode.QrScannerField" owl="1">
        <div class="o_qr_scanner_field d-flex align-items-center gap-1">
            <CharField t-props="charFieldProps"/>
            <button t-if="!props.readonly"
                    type="button"
                    class="btn btn-secondary btn-sm o_qr_scan_btn"
                    title="Scan QR/Barcode"
                    aria-label="Scan QR/Barcode"
                    t-on-click="onScanClick">
                <i class="fa fa-qrcode"/>
            </button>
            <button t-if="!props.readonly"
                    type="button"
                    class="btn btn-secondary btn-sm o_qr_upload_btn"
                    title="Scan from image file"
                    aria-label="Scan from image file"
                    t-on-click="onUploadClick">
                <i class="fa fa-image"/>
            </button>
            <input type="file"
                   name="qr_image"
                   class="o_qr_file_input d-none"
                   accept="image/*"
                   t-ref="fileInput"
                   t-on-change="onFileChange"/>
        </div>
    </t>
</templates>
